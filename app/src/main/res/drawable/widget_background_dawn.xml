<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="@color/widget_dawn_start"
                android:endColor="@color/widget_dawn_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerX="0.2"
                android:centerY="0.95"
                android:startColor="@color/widget_dawn_horizon_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerX="0.85"
                android:centerY="0.15"
                android:startColor="@color/widget_dawn_bloom"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- Sun disc, drawn before (i.e. behind) the mist bands so it reads as still climbing
         through them — Sunset's sun sits behind hard hills for the opposite effect. -->
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="bottom|left"
        android:left="26dp"
        android:bottom="30dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_dawn_sun" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_art_dawn" />
    <item
        android:width="2.5dp"
        android:height="2.5dp"
        android:gravity="center_vertical|right"
        android:right="34dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_dawn_spark" />
        </shape>
    </item>
    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="top|left"
        android:left="72dp"
        android:top="24dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_dawn_spark" />
        </shape>
    </item>
    <item
        android:width="1.8dp"
        android:height="1.8dp"
        android:gravity="bottom|right"
        android:right="52dp"
        android:bottom="34dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_dawn_spark" />
        </shape>
    </item>
    <!-- Bottom-edge scrim: floors the contrast under the app-name label, which is the only
         text on the card without a chip behind it. Fades out by mid-card so it grounds the
         artwork rather than dimming it. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/widget_footer_scrim"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <!-- Card frame: a thin translucent edge on top of everything else, so the widget reads as
         a bounded card rather than a borderless block of color on the home screen. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border" />
        </shape>
    </item>
</layer-list>
