<?xml version="1.0" encoding="utf-8"?>
<!-- Two snow drifts along the bottom edge, in near-white. They were pale washes on a dark sky
     when Winter was a dusk theme and white text ran over this band; the card now draws dark
     ink on light styles, so bright snow behind the footer label helps it rather than hiding
     it. The drifts still sit under the bottom scrim, which is what actually floors the
     label's contrast. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="150dp"
    android:viewportWidth="300"
    android:viewportHeight="150">
    <path
        android:fillColor="@color/widget_winter_drift_far"
        android:pathData="M0,150 L0,124 C48,108 92,128 142,119 C192,110 242,126 300,114 L300,150 Z" />
    <path
        android:fillColor="@color/widget_winter_drift_near"
        android:pathData="M0,150 L0,140 C58,124 110,142 170,133 C220,126 262,139 300,131 L300,150 Z" />
</vector>
