<?xml version="1.0" encoding="utf-8"?>
<!-- Ember: banked coals seen from above, kept to the bottom third. The only warm dark style in
     the set; the other six are all cool, which made a night-only user's four-card rotation read
     as narrower than its count. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/widget_ember_end"
                android:endColor="@color/widget_ember_start"
                android:type="linear" />
        </shape>
    </item>
    <!-- The bed of coals. Low and wide, and stopped well short of the tip: this is the light you
         read by, not the thing you look at. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:centerX="0.42"
                android:centerY="1.02"
                android:startColor="@color/widget_ember_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- Ash haze, off-centre so the heat is not symmetrical. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="110dp"
                android:centerX="0.74"
                android:centerY="0.9"
                android:startColor="@color/widget_ember_ash"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- Three sparks, rising and shrinking. Clear of the settings button's corner. -->
    <item
        android:width="2.4dp"
        android:height="2.4dp"
        android:gravity="bottom|left"
        android:left="54dp"
        android:bottom="46dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_ember_spark" />
        </shape>
    </item>
    <item
        android:width="1.8dp"
        android:height="1.8dp"
        android:gravity="bottom|left"
        android:left="86dp"
        android:bottom="62dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_ember_spark" />
        </shape>
    </item>
    <item
        android:width="1.4dp"
        android:height="1.4dp"
        android:gravity="bottom|right"
        android:right="72dp"
        android:bottom="74dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_ember_spark" />
        </shape>
    </item>
    <!-- Bottom-edge scrim: floors the contrast under the app-name label, which is the only
         text on the card without a chip behind it. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/widget_footer_scrim"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border" />
        </shape>
    </item>
</layer-list>
