<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/widget_autumn_start"
                android:endColor="@color/widget_autumn_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerX="0.12"
                android:centerY="0.3"
                android:startColor="@color/widget_autumn_sun_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.6"
                android:centerY="1.0"
                android:startColor="@color/widget_autumn_haze"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_art_autumn" />
    <item
        android:width="2.5dp"
        android:height="2.5dp"
        android:gravity="top|right"
        android:right="64dp"
        android:top="30dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_autumn_ember" />
        </shape>
    </item>
    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="center_vertical|left"
        android:left="30dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_autumn_ember" />
        </shape>
    </item>
    <item
        android:width="1.8dp"
        android:height="1.8dp"
        android:gravity="bottom|center_horizontal"
        android:bottom="26dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_autumn_ember" />
        </shape>
    </item>
    <!-- Card frame: a thin translucent edge on top of everything else, so the widget reads as
         a bounded card rather than a borderless block of color on the home screen. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border" />
        </shape>
    </item>
</layer-list>
