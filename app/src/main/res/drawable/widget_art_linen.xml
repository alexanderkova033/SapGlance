<?xml version="1.0" encoding="utf-8"?>
<!-- A weave: warp and weft across the whole card. The first style in the set that is not a
     landscape, which was the gap the roadmap had already named — nineteen cards and every one
     of them a place. Texture reads differently from scenery at a glance, and it fills the card
     evenly instead of piling everything along the bottom edge like the rest.
     Sparse on purpose: a real weave at this size turns to noise, so this is eight lines each
     way with the spacing uneven enough that the eye does not lock onto a grid. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="300dp"
    android:viewportWidth="300"
    android:viewportHeight="300">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/widget_linen_thread"
        android:strokeWidth="1.4"
        android:pathData="M0,26 L300,22 M0,64 L300,68 M0,108 L300,104 M0,146 L300,150
                          M0,192 L300,188 M0,232 L300,236 M0,270 L300,266" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/widget_linen_weft"
        android:strokeWidth="1.2"
        android:pathData="M28,0 L24,300 M70,0 L74,300 M116,0 L112,300 M158,0 L162,300
                          M204,0 L200,300 M244,0 L248,300 M282,0 L278,300" />
</vector>
