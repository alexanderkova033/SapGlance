<?xml version="1.0" encoding="utf-8"?>
<!-- Lilac: the one hue the light set was missing. It ran cool, cream, pink and green, so the violets belonged entirely to Sunset and Aurora, and only after dark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/widget_lilac_start"
                android:endColor="@color/widget_lilac_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:centerX="0.5"
                android:centerY="0.16"
                android:startColor="@color/widget_lilac_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.5"
                android:centerY="1.0"
                android:startColor="@color/widget_lilac_haze"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_art_lilac" />
    <item
        android:width="2.4dp"
        android:height="2.4dp"
        android:gravity="top|left"
        android:left="52dp"
        android:top="40dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_lilac_mote" />
        </shape>
    </item>
    <!-- Bottom-edge scrim: floors the contrast under the app-name label, which is the only
         text on the card without a chip behind it. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/widget_footer_scrim_light"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <!-- Card frame, in the dark rim the light styles use. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border_dark" />
        </shape>
    </item>
</layer-list>
