<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:startColor="@color/widget_sunset_start"
                android:endColor="@color/widget_sunset_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.5"
                android:centerY="1.0"
                android:startColor="@color/widget_sunset_horizon_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerX="0.12"
                android:centerY="0.08"
                android:startColor="@color/widget_sunset_bloom"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- Solid sun disc, drawn before (i.e. behind) the hill silhouette so the hills read as
         cutting across its lower half — classic "sun setting behind hills" composition. -->
    <item
        android:width="64dp"
        android:height="64dp"
        android:gravity="bottom|center_horizontal"
        android:bottom="26dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_sunset_sun" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_art_sunset" />
    <item
        android:width="2.5dp"
        android:height="2.5dp"
        android:gravity="bottom|left"
        android:left="24dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_sunset_ember" />
        </shape>
    </item>
    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="bottom|center_horizontal"
        android:bottom="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_sunset_ember" />
        </shape>
    </item>
    <item
        android:width="1.8dp"
        android:height="1.8dp"
        android:gravity="bottom|right"
        android:right="46dp"
        android:bottom="26dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_sunset_ember" />
        </shape>
    </item>
    <!-- Bottom-edge scrim: floors the contrast under the app-name label, which is the only
         text on the card without a chip behind it. Fades out by mid-card so it grounds the
         artwork rather than dimming it. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/widget_footer_scrim"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <!-- Card frame: a thin translucent edge on top of everything else, so the widget reads as
         a bounded card rather than a borderless block of color on the home screen. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border" />
        </shape>
    </item>
</layer-list>
