<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shares Forest's 135° base angle: there are only eight legal gradient angles and more
         styles than that, so some doubling up is unavoidable — a deep green forest against a
         bright snowfield is a pair nobody will confuse. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/widget_winter_start"
                android:endColor="@color/widget_winter_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerX="0.8"
                android:centerY="0.12"
                android:startColor="@color/widget_winter_halo"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.15"
                android:centerY="0.9"
                android:startColor="@color/widget_winter_shade"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_art_winter" />
    <item
        android:width="2.5dp"
        android:height="2.5dp"
        android:gravity="top|left"
        android:left="36dp"
        android:top="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_winter_flake" />
        </shape>
    </item>
    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="center_vertical|right"
        android:right="28dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_winter_flake" />
        </shape>
    </item>
    <item
        android:width="1.8dp"
        android:height="1.8dp"
        android:gravity="top|center_horizontal"
        android:top="34dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_winter_flake" />
        </shape>
    </item>
    <!-- Bottom-edge scrim: floors the contrast under the app-name label, which is the only
         text on the card without a chip behind it. Fades out by mid-card so it grounds the
         artwork rather than dimming it. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/widget_footer_scrim_light"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <!-- Card frame, in the dark rim the light styles use — the white one every dark style
         carries would be invisible against snow. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border_dark" />
        </shape>
    </item>
</layer-list>
