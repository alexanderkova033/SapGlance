<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shares Forest's 135° base angle: with nine styles and only eight legal gradient
         angles, exactly one pair has to double up, and a green forest scene against an icy
         blue snowfield is the pair least likely to be mistaken for each other. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/widget_winter_start"
                android:endColor="@color/widget_winter_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerX="0.8"
                android:centerY="0.12"
                android:startColor="@color/widget_winter_halo"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.15"
                android:centerY="0.9"
                android:startColor="@color/widget_winter_shade"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_art_winter" />
    <item
        android:width="2.5dp"
        android:height="2.5dp"
        android:gravity="top|left"
        android:left="36dp"
        android:top="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_winter_flake" />
        </shape>
    </item>
    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="center_vertical|right"
        android:right="28dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_winter_flake" />
        </shape>
    </item>
    <item
        android:width="1.8dp"
        android:height="1.8dp"
        android:gravity="top|center_horizontal"
        android:top="34dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_winter_flake" />
        </shape>
    </item>
    <!-- Card frame: a thin translucent edge on top of everything else, so the widget reads as
         a bounded card rather than a borderless block of color on the home screen. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border" />
        </shape>
    </item>
</layer-list>
