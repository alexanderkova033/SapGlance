<?xml version="1.0" encoding="utf-8"?>
<!-- The settings-gear chip for the light styles. Same construction as widget_settings_button_bg
     (shadow, gradient body, top highlight) but bright rather than top-lit-over-dark: on a pale
     card the dark chip's lower half reads as a smudge, and its white rim disappears entirely.
     This one is nearly opaque white with a dark rim, which is also what lets the gear glyph be
     tinted dark and still sit on a surface of its own. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="1.5dp"
        android:left="1dp"
        android:right="0.5dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_settings_button_light_shadow" />
        </shape>
    </item>
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="1dp"
        android:bottom="1.5dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/widget_settings_button_light_fill_top"
                android:endColor="@color/widget_settings_button_light_fill_bottom"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/widget_card_border_dark" />
        </shape>
    </item>
    <item
        android:width="15dp"
        android:height="7dp"
        android:gravity="top|center_horizontal"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_settings_button_light_highlight" />
        </shape>
    </item>
</layer-list>
