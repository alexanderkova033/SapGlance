<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/widget_midnight_start"
                android:endColor="@color/widget_midnight_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="130dp"
                android:centerX="0.18"
                android:centerY="0.14"
                android:startColor="@color/widget_midnight_moon_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.22"
                android:centerY="0.95"
                android:startColor="@color/widget_midnight_aurora_glow"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <!-- The moon: one pale disc, in the left corner.

         Two things changed here and they are worth keeping straight. It sat in the *right*
         corner, and that is where the settings button lives on every style, so the button landed
         on the moon and the pair read as two overlapping discs — the one place in the set where
         the chrome covered a style's subject rather than empty artwork. Nothing else in any
         background puts more than a 2.5dp speck in that corner, so this is the only drawable that
         had to move.

         Moving it also retired a trick that had never really worked: the moon used to be a
         crescent, made by painting a second disc of the gradient's own start color over part of
         the first to bite a shape out of it. A flat bite can only disappear where the gradient
         happens to be that exact color, and behind the moon it never is — it is a linear ramp
         crossed by the moon glow's radial, and where along the ramp the corner falls moves with
         the card's aspect ratio. So the "crescent" rendered as a pale disc with a black disc
         punched through it at every size. A full moon needs nothing to match and cannot come
         apart. Held clear of the top of the longest tip by a couple of dp, which is why this is
         8dp rather than the 12 it was. -->
    <item
        android:width="28dp"
        android:height="28dp"
        android:gravity="top|left"
        android:left="20dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_midnight_moon_body" />
        </shape>
    </item>
    <!-- Moved out of the moon's new corner, and kept clear of the settings button's own. -->
    <item
        android:width="2.5dp"
        android:height="2.5dp"
        android:gravity="top|right"
        android:right="54dp"
        android:top="30dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_midnight_star" />
        </shape>
    </item>
    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="top|center_horizontal"
        android:top="22dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_midnight_star" />
        </shape>
    </item>
    <item
        android:width="1.8dp"
        android:height="1.8dp"
        android:gravity="top|left"
        android:left="66dp"
        android:top="9dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_midnight_star" />
        </shape>
    </item>
    <!-- Bottom-edge scrim: floors the contrast under the app-name label, which is the only
         text on the card without a chip behind it. Fades out by mid-card so it grounds the
         artwork rather than dimming it. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/widget_footer_scrim"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <!-- Card frame: a thin translucent edge on top of everything else, so the widget reads as
         a bounded card rather than a borderless block of color on the home screen. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border" />
        </shape>
    </item>
</layer-list>
