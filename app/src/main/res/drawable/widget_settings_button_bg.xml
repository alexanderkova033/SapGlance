<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass chip behind the widget's settings gear, replacing a flat dark scrim: a soft
     offset shadow lifts it off the card art, a top-lit gradient gives it depth, and a small
     highlight near the top suggests light catching a curved glass surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="1.5dp"
        android:left="1dp"
        android:right="0.5dp"
        android:bottom="0dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_settings_button_shadow" />
        </shape>
    </item>
    <item
        android:top="0dp"
        android:left="0dp"
        android:right="1dp"
        android:bottom="1.5dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="@color/widget_settings_button_fill_top"
                android:endColor="@color/widget_settings_button_fill_bottom"
                android:type="linear" />
            <stroke android:width="1dp" android:color="@color/widget_card_border" />
        </shape>
    </item>
    <item
        android:width="15dp"
        android:height="7dp"
        android:gravity="top|center_horizontal"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_settings_button_highlight" />
        </shape>
    </item>
</layer-list>
