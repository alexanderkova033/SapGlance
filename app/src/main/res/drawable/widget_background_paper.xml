<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/widget_paper_start"
                android:endColor="@color/widget_paper_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:centerX="0.75"
                android:centerY="0.12"
                android:startColor="@color/widget_paper_lamp"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerX="0.1"
                android:centerY="0.95"
                android:startColor="@color/widget_paper_shade"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_art_paper" />
    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="top|left"
        android:left="44dp"
        android:top="46dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_paper_speck" />
        </shape>
    </item>
    <item
        android:width="1.6dp"
        android:height="1.6dp"
        android:gravity="center_vertical|right"
        android:right="32dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_paper_speck" />
        </shape>
    </item>
    <item
        android:width="1.4dp"
        android:height="1.4dp"
        android:gravity="bottom|left"
        android:left="62dp"
        android:bottom="30dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_paper_speck" />
        </shape>
    </item>
    <!-- Card frame, in the dark rim the light styles use — the white one every dark style
         carries would be invisible against a cream page. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border_dark" />
        </shape>
    </item>
</layer-list>
