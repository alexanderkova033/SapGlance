<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/widget_aurora_start"
                android:endColor="@color/widget_aurora_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:centerX="0.2"
                android:centerY="0.25"
                android:startColor="@color/widget_aurora_veil_green"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="140dp"
                android:centerX="0.75"
                android:centerY="0.15"
                android:startColor="@color/widget_aurora_veil_violet"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item android:drawable="@drawable/widget_art_aurora" />
    <item
        android:width="2.2dp"
        android:height="2.2dp"
        android:gravity="top|left"
        android:left="52dp"
        android:top="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_aurora_star" />
        </shape>
    </item>
    <item
        android:width="1.8dp"
        android:height="1.8dp"
        android:gravity="top|center_horizontal"
        android:top="26dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_aurora_star" />
        </shape>
    </item>
    <item
        android:width="2dp"
        android:height="2dp"
        android:gravity="top|right"
        android:right="58dp"
        android:top="16dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_aurora_star" />
        </shape>
    </item>
    <!-- Card frame: a thin translucent edge on top of everything else, so the widget reads as
         a bounded card rather than a borderless block of color on the home screen. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_card_border" />
        </shape>
    </item>
</layer-list>
