        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/widget_rain_ripple"
        android:strokeWidth="1.5"
        android:pathData="M188,126 C188,124.07 193.82,122.5 201,122.5 C208.18,122.5 214,124.07 214,126 C214,127.93 208.18,129.5 201,129.5 C193.82,129.5 188,127.93 188,126 Z" />
