<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">SapGlance</string>

    <string name="widget_description">A rotating wellness tip. Tap it for a new one, or the gear icon for settings.</string>
    <string name="widget_settings_action">Open settings</string>

    <string name="settings_title">@string/app_name</string>

    <string name="settings_variety_title">More variety</string>
    <string name="settings_variety_label_practical">Practical</string>
    <string name="settings_variety_label_balanced">Balanced</string>
    <string name="settings_variety_label_playful">Reflective</string>
    <!-- Written to sound like a person, not a spec. The original set named the internal pools
         ("Mostly motivation, philosophy & wellbeing"), which made Practical the real option and
         Reflective the leftovers. Keep all three the same length and register: whichever one
         you pick should sound like the good choice. -->
    <string name="settings_variety_state_practical">Little things you can try today</string>
    <string name="settings_variety_state_balanced">A bit of both</string>
    <string name="settings_variety_state_playful">Something to mull over</string>

    <string name="settings_tip_source_quote">“%1$s”</string>
    <string name="settings_tip_refresh_action">Get a different tip</string>
    <plurals name="settings_tip_sources_header">
        <item quantity="one">Backed by %1$d source</item>
        <item quantity="other">Backed by %1$d sources</item>
    </plurals>
    <!-- A quotation is attributed, not evidenced: "Backed by 1 source" would misrepresent a
         line of Stoic philosophy as a research finding. -->
    <string name="settings_tip_source_attribution">Quoted from</string>

    <!-- "Health" rather than "Practical": the label answers "what is this about", which is what
         a reader glancing at the card wants, not "which register is it written in". It also
         keeps the word clear of the *variety setting* called "Practical" further down the same
         screen — one word meaning two different things on one screen is worse than two words. -->
    <string name="settings_tip_kind_health">Health</string>
    <string name="settings_tip_kind_motivation">Motivation</string>
    <string name="settings_tip_kind_philosophy">Philosophy</string>
    <string name="settings_tip_kind_wellbeing">Wellbeing</string>
    <string name="settings_tip_label_combined">%1$s · %2$s</string>

    <string name="settings_daypart_morning">Morning</string>
    <string name="settings_daypart_afternoon">Afternoon</string>
    <string name="settings_daypart_evening">Evening</string>
    <string name="settings_daypart_night">Night</string>

    <string name="settings_language_title">Language</string>
    <!-- The three options are deliberately not "English / Русский / System" in that order: the
         system option is the default and reads as the answer for someone who has not thought
         about it, so it comes first. Each language names itself, which is the one naming rule
         that survives the reader not speaking the language the app is currently in. -->
    <string name="settings_language_label_system">System</string>
    <string name="settings_language_label_english">English</string>
    <string name="settings_language_label_russian">Русский</string>
    <string name="settings_language_state_system">Following your phone: %1$s</string>
    <string name="settings_language_state_pinned">Tips are shown in %1$s</string>
    <!-- Shown under the picker, always, not just after a change. Switching language resets the
         rotation because history is keyed by tip *text*, and finding that out afterwards is
         worse than reading one line about it first. Deliberately does not promise the two
         languages are remembered separately: they share one 160-entry history, so a long spell
         in one language pushes the other's tips out of it. Saying otherwise would be a nicer
         sentence and a false one. -->
    <string name="settings_language_history_note">Switching starts a fresh rotation.</string>

    <string name="settings_about_title">About</string>
    <string name="settings_about_privacy_local">Tips and history stay on this phone</string>
    <string name="settings_about_privacy_account">No account</string>
    <string name="settings_about_privacy_ads">No tracking or ads</string>
</resources>
