<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher icon background only (not the app's teal-green theme color): a single
         flat olive-brown, brown-dominant with a gentle green undertone rather than a
         gradient. Same hue/ratio as an earlier, darker pass of this color, just scaled
         brighter — the darker version read as muddy rather than warm earth. -->
    <color name="ic_launcher_background">#5A492A</color>

    <!-- Thin translucent edge drawn on top of every widget style's background, so the card
         reads as a distinct object against arbitrary home-screen wallpaper instead of a bare
         rectangle of color with no boundary. One value per ink direction rather than one
         globally: a white rim is invisible on the light styles, and a dark rim is invisible on
         the dark ones, so the "frame" language only stays consistent by flipping with the ink. -->
    <color name="widget_card_border">#4DFFFFFF</color>
    <color name="widget_card_border_dark">#38000000</color>

    <!-- Bottom-edge scrim, drawn on every style just under the card frame: opaque-ish at the
         very bottom, gone by mid-card. The app-name label sits on the bottom edge and is the
         only text with no chip of its own, so whatever the artwork happens to do down there is
         what it has to be read against — and the art *does* do things down there, since a
         bottom-anchored horizon is how most of these scenes are built. Measured: without this,
         Ocean's wave crests and Dawn's mist band put the label at 2.7:1, and no amount of text
         alpha fixes it because the label is already pale-on-pale at that point. With it the
         worst style is 4.9:1. Kept at 30% — the lightest value that clears AA everywhere —
         since its job is to floor the contrast, not to visibly darken the artwork. -->
    <color name="widget_footer_scrim">#4D000000</color>
    <color name="widget_footer_scrim_light">#4DFFFFFF</color>

    <!-- Glass-chip look behind the settings gear icon (widget_settings_button_bg.xml): a
         top-lit translucent gradient plus a small highlight and a soft offset shadow, rather
         than a single flat scrim tone. Kept neutral (white/black, no brand hue) so it reads
         against every dark background style alike, unlike a style-matched tint would — paired
         with widget_card_border for the rim, so the button reads as part of the same "frame"
         language as the card itself. -->
    <color name="widget_settings_button_fill_top">#59FFFFFF</color>
    <color name="widget_settings_button_fill_bottom">#40000000</color>
    <color name="widget_settings_button_highlight">#4DFFFFFF</color>
    <color name="widget_settings_button_shadow">#33000000</color>

    <!-- The same chip re-tuned for the light styles (widget_settings_button_bg_light.xml).
         Not a tint of the dark one: on a pale card the dark chip's black lower half turns the
         gear into a dark blob, so this stays bright and earns its edge from a dark rim and a
         stronger drop shadow instead. The gear glyph itself is tinted dark at the call site. -->
    <color name="widget_settings_button_light_fill_top">#F2FFFFFF</color>
    <color name="widget_settings_button_light_fill_bottom">#B8FFFFFF</color>
    <color name="widget_settings_button_light_highlight">#99FFFFFF</color>
    <color name="widget_settings_button_light_shadow">#2E1A2436</color>

