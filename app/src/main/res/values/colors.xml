         tint on a night sky, which is what keeps the two from reading as the same card. -->
    <color name="widget_aurora_start">#070B1C</color>
    <color name="widget_aurora_end">#12203A</color>
    <color name="widget_aurora_veil_green">#4D2FD69B</color>
