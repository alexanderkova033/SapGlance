    <color name="widget_aurora_ridge_front">#E60A1226</color>
    <color name="widget_aurora_star">#B3E8F0FF</color>

    <!-- First light: a cool violet sky still holding overnight, warming to dusty rose at the
         horizon. Sunset's opposite number, so it stays cooler and mistier than Sunset's
         magenta-to-orange and swaps that theme's hard hill silhouette for soft mist bands. -->
