    <color name="widget_rain_drop">#99D6E8F5</color>

    <!-- Winter, now a genuinely bright snow scene. It was originally forced into a dark "winter
         dusk" because the card's text was white everywhere and bright drifts would have eaten
         the footer label; the ink now flips per style (see WidgetInk in TipWidget.kt), so the
         snow can actually be snow-colored. -->
    <color name="widget_winter_start">#F1F8FD</color>
    <color name="widget_winter_end">#AECBE6</color>
    <color name="widget_winter_halo">#66FFFFFF</color>
    <color name="widget_winter_shade">#33587FA8</color>
    <color name="widget_winter_drift_far">#B3FFFFFF</color>
    <color name="widget_winter_drift_near">#F2FFFFFF</color>
    <color name="widget_winter_flake">#7A5E86A8</color>

    <!-- Warm paper. The plainest card in the set on purpose: no scene, no horizon, just a page
         with a faint rule, a soft fold shadow and a lamp glow. Every other style competes with
         the tip for attention to some degree; this one is the null option, and on a light card
         with near-black text it is also the most legible thing the rotation can produce. -->
    <color name="widget_paper_start">#FAF3E2</color>
    <color name="widget_paper_end">#E2D2B2</color>
    <color name="widget_paper_lamp">#59FFFBEC</color>
    <color name="widget_paper_shade">#2E8A6F3C</color>
    <color name="widget_paper_rule">#2E7A6033</color>
    <color name="widget_paper_fold">#38A98A55</color>
    <color name="widget_paper_speck">#598A6E45</color>

    <!-- Spring meadow: pale sky above, sunlit grass below. The one light style that keeps a
         horizon, so the light group isn't three flat washes. Sits opposite Forest in the same
         hue family — deep and nocturnal there, bright and open here. -->
    <color name="widget_meadow_start">#DFEFF8</color>
    <color name="widget_meadow_end">#CFE2A4</color>
    <color name="widget_meadow_sun">#59FFF3B0</color>
    <color name="widget_meadow_haze">#2E7FA83C</color>
    <!-- The grass is much paler than a grass silhouette "should" be, and measured rather than
         eyeballed: the footer label sits on this band, and at the saturation this started at
         (#547A2C at 70%) dark text on it came to 3.2:1, under the 4.5:1 floor. Lightened until
         the label clears it. Nothing else on the light cards was close — this is the only
         style whose art puts a mid-tone mass under text. -->
    <color name="widget_meadow_grass_back">#7A82AC53</color>
    <color name="widget_meadow_grass_front">#99649A39</color>
    <color name="widget_meadow_blade">#7A4F7330</color>
    <color name="widget_meadow_petal">#CCF2F0FA</color>
    <color name="widget_meadow_pollen">#B3C79A2E</color>

    <!-- Blossom: pale rose with petals adrift. Carries over the falling-things motion that the
         removed Autumn style had, without its heavy rust palette — the motion was the part
         worth keeping. -->
    <color name="widget_blossom_start">#FDF1F4</color>
    <color name="widget_blossom_end">#EFC5D5</color>
    <color name="widget_blossom_glow">#59FFF3E4</color>
    <color name="widget_blossom_shade">#2ED2789C</color>
