    <color name="widget_blossom_petal_near">#B3D96C99</color>
    <color name="widget_blossom_mote">#8CC97D9E</color>

    <!-- Ember. Deep and warm, for the night palette, which had only four styles and so repeated
         a background one night in four. Warm rather than blue on purpose: every other dark style
         is cool, so a night-only user was seeing four shades of the same idea. The glow sits low
         and never reaches the tip, because embers you can read by are a lamp, not a fire. -->
    <color name="widget_ember_start">#17100E</color>
    <color name="widget_ember_end">#40201A</color>
    <color name="widget_ember_glow">#4DFF7A3D</color>
    <color name="widget_ember_ash">#2EFFB27A</color>
    <color name="widget_ember_spark">#A6FFD1A3</color>

    <!-- Slate. The quietest card in the set and deliberately the plainest: no subject, no
